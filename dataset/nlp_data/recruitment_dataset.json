RECRUITMENT_HASHTAGS = [
    "#cha🍕", "#4L", "#4letras", "#plebada", "#belicones",
    "#trabajo", "#jale", "#gentedel", "#fyp", "#ng"
]

SAFE_HASHTAGS = [
    "#gaming", "#escuela", "#tarea", "#amigos", "#fyp",
    "#minecraft", "#ranked", "#comida", "#futbol", "#clase"
]

RECRUITMENT_EMOJIS = ["💰", "🤑", "👑", "🫡", "🍕", "🐓", "👀", "📡", "🛻"]
SAFE_EMOJIS = ["😂", "🥳", "🎮", "📚", "🍟", "⚽", "🐶", "🎧", "🍕"]

def add_noise(text):
    text = text.lower()

    replacements = {
        "mensaje": random.choice(["mensaje", "msj", "dm", "inbox"]),
        "información": random.choice(["información", "info", "informes"]),
        "trabajo": random.choice(["trabajo", "jale", "chamba"]),
        "dinero": random.choice(["dinero", "lana", "feria"]),
        "buena paga": random.choice(["buena paga", "buena feria", "se gana bien"]),
        "ocupamos": random.choice(["ocupamos", "se ocupa", "buscamos"]),
        "quieres": random.choice(["quieres", "kieres", "qieres"]),
    }

    for old, new in replacements.items():
        text = text.replace(old, new)

    if random.random() < 0.25:
        text = text.replace("que", "q")
    if random.random() < 0.18:
        text = text.replace("para", "pa")
    if random.random() < 0.15:
        text = text.replace("más", "mas")
    if random.random() < 0.12:
        text = text.replace("á", "a").replace("é", "e").replace("í", "i").replace("ó", "o").replace("ú", "u")

    return text

def make_example(label):
    if label == "reclutamiento":
        base = random.choice(RECRUITMENT_TEMPLATES)
        hashtags = RECRUITMENT_HASHTAGS
        emojis = RECRUITMENT_EMOJIS
    else:
        base = random.choice(SAFE_TEMPLATES)
        hashtags = SAFE_HASHTAGS
        emojis = SAFE_EMOJIS

    text = add_noise(base)

    if random.random() < 0.45:
        text += " " + random.choice(emojis)

    if random.random() < 0.40:
        text += " " + random.choice(hashtags)

    if random.random() < 0.20:
        text = random.choice(["oye", "bro", "carnal", "banda", "gente"]) + " " + text

    if random.random() < 0.15:
        text += " " + random.choice(["hoy", "rápido", "al rato", "sin fallar", "avisen"])

    return {
        "text": text.strip(),
        "label": label
    }

dataset = []

for _ in range(5000):
    dataset.append(make_example("reclutamiento"))

for _ in range(5000):
    dataset.append(make_example("safe"))

random.shuffle(dataset)

with open("recruitment_dataset_10000.json", "w", encoding="utf-8") as f:
    json.dump(dataset, f, ensure_ascii=False, indent=2)

print("Dataset creado:", len(dataset))
print(dataset[:5])


//entrenar modelo
import tensorflow as tf
from sklearn.model_selection import train_test_split

texts = np.array([item["text"] for item in dataset])
labels = np.array([1 if item["label"] == "reclutamiento" else 0 for item in dataset])

X_train, X_test, y_train, y_test = train_test_split(
    texts,
    labels,
    test_size=0.2,
    random_state=42,
    stratify=labels
)

vectorizer = tf.keras.layers.TextVectorization(
    max_tokens=8000,
    output_mode="int",
    output_sequence_length=50
)

vectorizer.adapt(X_train)

def vectorize_texts(text_array):
    return vectorizer(tf.constant(text_array)).numpy()

X_train_vec = vectorize_texts(X_train)
X_test_vec = vectorize_texts(X_test)

model = tf.keras.Sequential([
    tf.keras.Input(shape=(50,), dtype=tf.int64),
    tf.keras.layers.Embedding(input_dim=8000, output_dim=32),
    tf.keras.layers.GlobalAveragePooling1D(),
    tf.keras.layers.Dense(32, activation="relu"),
    tf.keras.layers.Dropout(0.2),
    tf.keras.layers.Dense(1, activation="sigmoid")
])

model.compile(
    optimizer="adam",
    loss="binary_crossentropy",
    metrics=["accuracy"]
)

history = model.fit(
    X_train_vec,
    y_train,
    validation_data=(X_test_vec, y_test),
    epochs=8,
    batch_size=32
)

//probar frases
test_texts = np.array([
    "manda mensaje para informes hay buena paga",
    "hoy jugamos ranked en la noche",
    "ánimo plebada jálese a laborar 4 letras",
    "ocupamos healer para la partida",
    "se ocupa gente para cuidar la entrada y avisar",
    "vamos por papitas saliendo de clase"
])

test_vec = vectorize_texts(test_texts)
preds = model.predict(test_vec)

for text, score in zip(test_texts, preds):
    label = "reclutamiento" if score[0] >= 0.5 else "safe"
    print(f"{text} -> {label} ({score[0]:.4f})")


//exportar a .tflite
converter = tf.lite.TFLiteConverter.from_keras_model(model)
tflite_model = converter.convert()

with open("recruitment_detector.tflite", "wb") as f:
    f.write(tflite_model)

print("Modelo exportado: recruitment_detector.tflite")

//guardar vocabulario y labels
vocab = vectorizer.get_vocabulary()

with open("vocab.txt", "w", encoding="utf-8") as f:
    for token in vocab:
        f.write(token + "\n")

with open("labels.txt", "w", encoding="utf-8") as f:
    f.write("safe\n")
    f.write("reclutamiento\n")

print("Archivos guardados: vocab.txt y labels.txt")

